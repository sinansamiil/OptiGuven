@model IEnumerable<OptiGuven.Web.Models.IsgIhlalleri>
@{
    ViewBag.Title = "Geçmiş İSG İhlalleri Arşivi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
        <h2><i class="fa-solid fa-folder-open text-secondary"></i> İncelenmiş İSG İhlalleri Arşivi</h2>
        <div>
            <!-- İSG için özelleştirilmiş PDF butonu -->
            <label class="fw-bold"><input type="checkbox" id="selectAll" onclick="toggleSelectAll(this)"> Tümünü Seç</label>
            <button type="button" class="btn btn-danger fw-bold shadow-sm" onclick="secilenleriIsgPdfAl()">
                📄 Seçilenleri PDF İndir
            </button>
            <a href="@Url.Action("IsgKontrolPaneli", "Makine")" class="btn btn-outline-primary shadow-sm fw-bold">
                <i class="fa-solid fa-arrow-left"></i> Aktif Uyarılara Dön
            </a>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var ihlal in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-success" style="opacity: 0.85;">
                        <input type="checkbox" class="ihlalSecim" value="@ihlal.Id" style="transform: scale(1.5);">
                        <!-- Resmi siyah beyaz (grayscale) yaparak arşiv hissiyatı veriyoruz -->
                        <img src="@ihlal.FotografYolu" class="card-img-top" alt="İhlal Görseli" style="height: 180px; object-fit: cover; filter: grayscale(80%);">
                        <div class="card-body">
                            <h6 class="card-title text-success fw-bold">@ihlal.IhlalTipi</h6>
                            <p class="card-text text-muted mb-1" style="font-size: 0.85rem;">
                                <strong>Kamera ID:</strong> @ihlal.KameraId <br />
                                <strong>Tarih:</strong> @(ihlal.Tarih.HasValue ? ihlal.Tarih.Value.ToString("dd.MM.yyyy HH:mm") : "-")
                            </p>
                        </div>
                        <div class="card-footer bg-light border-top-0 text-center text-success fw-bold">
                            <i class="fa-solid fa-check-circle"></i> İncelendi
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <h5 class="text-muted">Geçmişe ait incelenmiş bir kayıt bulunmuyor.</h5>
            </div>
        }
    </div>
</div>

<script>
    function secilenleriIsgPdfAl() {
        var secilenler = [];
        $('.ihlalSecim:checked').each(function() {
            secilenler.push($(this).val());
        });

        if(secilenler.length === 0) {
            alert("Lütfen en az bir İSG ihlali seçin!");
            return;
        }
        window.location.href = '@Url.Action("SecilenGecmisIsgPdf", "Makine")?idListesi=' + secilenler.join(',');
    }
</script>

<script>
    function toggleSelectAll(source) {
        // Kartların içindeki tüm checkboxları bul
        var checkboxes = document.querySelectorAll('.ihlalSecim');
        checkboxes.forEach(function (checkbox) {
            checkbox.checked = source.checked;
        });
    }
</script>