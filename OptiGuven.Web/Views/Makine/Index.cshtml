@model IEnumerable<OptiGuven.Web.Models.Makineler>

@{
    ViewBag.Title = "Fabrika Makineleri";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ortak menüyü buradan çekiyoruz
}

<style>
    .table-container {
        margin-top: 20px;
        margin-bottom: 30px;
        background: white;
        padding: 25px;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
</style>

<div class="table-container">
    <h2 class="mb-4 text-center">🏭 Üretim Hattı Makineleri</h2>

    @if (Session["Rol"]?.ToString() == "Admin")
    {
        <a href="@Url.Action("Create")" class="btn btn-success mb-3 fw-bold">+ Yeni Makine Ekle</a>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Makine Kodu</th>
                    <th>Makine Adı</th>
                    <th>Mevcut Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.MakineKodu</strong></td>
                            <td>@item.Ad</td>
                            <td>
                                <span class="badge @(item.Durum == "Aktif" ? "bg-success" : (item.Durum == "Bakımda" ? "bg-danger" : "bg-warning text-dark"))">
                                    @item.Durum
                                </span>
                            </td>

                            <td class="text-end text-nowrap">
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-primary">Düzenle</a>

                                @if (Session["Rol"]?.ToString() == "Admin")
                                {
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger">Sil</a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Sistemde henüz kayıtlı makine bulunmamaktadır.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>